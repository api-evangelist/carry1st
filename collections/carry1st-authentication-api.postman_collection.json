              "content": "Authenticate with your API Key and API Secret (HTTP Basic) to obtain an Access Token and Refresh Token used for all subsequent Gateway requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "pay1st",
                "auth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
