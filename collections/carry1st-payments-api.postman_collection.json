          "name": "Create Payment Request",
          "request": {
            "name": "Create Payment Request",
            "description": {
              "content": "Create a payment request before a payment is made. Requires a valid Access Token plus an X-SIGNATURE (hex HMAC-SHA256) and X-TIMESTAMP header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "pay1st",
                "payments",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Hex-encoded HMAC-SHA256 signature of the timestamp + request JSON.",
                "key": "X-SIGNATURE",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Current time in ISO-8601, identical to the timestamp used to build the signature.",
                "key": "X-TIMESTAMP",
                "value": "<dateTime>"
              },
              {
                "key": "Content-Type",
                "value": "application/vnd.carry1st.payments.payment+json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "AccessToken"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
