              "mode": "raw",
              "raw": "{\n  \"amount\": \"<number>\",\n  \"countryCode\": \"<string>\",\n  \"currencyCode\": \"<string>\",\n  \"partnerReference\": \"<string>\",\n  \"products\": [\n    {\n      \"currencyCode\": \"<string>\",\n      \"price\": \"<number>\",\n      \"quantity\": \"<integer>\",\n      \"sku\": \"<string>\",\n      \"title\": \"<string>\"\n    },\n    {\n      \"currencyCode\": \"<string>\",\n      \"price\": \"<number>\",\n      \"quantity\": \"<integer>\",\n      \"sku\": \"<string>\",\n      \"title\": \"<string>\"\n    }\n  ],\n  \"metadata\": [\n    {\n      \"key\": \"<string>\",\n      \"value\": \"<string>\"\n    },\n    {\n      \"key\": \"<string>\",\n      \"value\": \"<string>\"\n    }\n  ],\n  \"callbackSuccessUrl\": \"<string>\",\n  \"callbackFailureUrl\": \"<string>\",\n  \"callbackPendingUrl\": \"<string>\",\n  \"callbackCancelUrl\": \"<string>\",\n  \"webhookUrl\": \"<string>\"\n}",
